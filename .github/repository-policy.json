{
  "repository": "Johnson-Dev-Agent-Management/questos",
  "administrator": "Joshbomb75",
  "settings": {
    "description": "A small Godot/OpenXR performance playground for Meta Quest 2 on stock Horizon OS.",
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "allow_update_branch": true,
    "delete_branch_on_merge": true,
    "has_issues": true,
    "has_wiki": false,
    "has_projects": false,
    "security_and_analysis": {
      "secret_scanning": {"status": "enabled"},
      "secret_scanning_push_protection": {"status": "enabled"}
    }
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "rulesets": [
    {
      "name": "questos-main-review",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {"ref_name": {"include": ["refs/heads/main"], "exclude": []}},
      "rules": [
        {"type": "deletion"},
        {"type": "non_fast_forward"},
        {"type": "required_linear_history"},
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 1,
            "dismiss_stale_reviews_on_push": true,
            "require_code_owner_review": true,
            "require_last_push_approval": true,
            "required_review_thread_resolution": true,
            "allowed_merge_methods": ["squash"]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {"context": "repository-checks", "integration_id": 15368}
            ]
          }
        }
      ]
    },
    {
      "name": "questos-main-owner-updates",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [
        {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
      ],
      "conditions": {"ref_name": {"include": ["refs/heads/main"], "exclude": []}},
      "rules": [{"type": "update"}]
    },
    {
      "name": "questos-owner-tags",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [
        {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
      ],
      "conditions": {"ref_name": {"include": ["~ALL"], "exclude": []}},
      "rules": [
        {"type": "creation"},
        {"type": "update"},
        {"type": "deletion"},
        {"type": "non_fast_forward"}
      ]
    }
  ]
}
