; Open this project with the repository-pinned Godot editor.
config_version=5

[application]
config/name="QuestOS"
config/version="0.1.0-p1"
config/icon="res://icon.svg"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]
enabled=PackedStringArray("res://addons/quest_candidate/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.075, 1)

[xr]
openxr/enabled=true
openxr/default_action_map="res://input/quest_touch.tres"
openxr/reference_space=1
shaders/enabled=true
