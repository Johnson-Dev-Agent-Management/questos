[gd_resource type="OpenXRActionMap" format=3]

[sub_resource type="OpenXRAction" id="OpenXRAction_earqv"]
resource_name = "aim_pose"
localized_name = "Aim Pose"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_d1eat"]
resource_name = "select"
localized_name = "Select"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_3hujn"]
resource_name = "exit"
localized_name = "Exit"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="OpenXRActionSet_k6xom"]
resource_name = "quest"
localized_name = "QuestOS controls"
actions = [SubResource("OpenXRAction_earqv"), SubResource("OpenXRAction_d1eat"), SubResource("OpenXRAction_3hujn")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_s7apu"]
action = SubResource("OpenXRAction_earqv")
binding_path = "/user/hand/left/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_ep310"]
action = SubResource("OpenXRAction_d1eat")
binding_path = "/user/hand/left/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_teqpe"]
action = SubResource("OpenXRAction_3hujn")
binding_path = "/user/hand/left/input/y/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_8mw26"]
action = SubResource("OpenXRAction_earqv")
binding_path = "/user/hand/right/input/aim/pose"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_xjv8s"]
action = SubResource("OpenXRAction_d1eat")
binding_path = "/user/hand/right/input/trigger/value"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_ihao1"]
action = SubResource("OpenXRAction_3hujn")
binding_path = "/user/hand/right/input/b/click"

[sub_resource type="OpenXRInteractionProfile" id="OpenXRInteractionProfile_au1k2"]
interaction_profile_path = "/interaction_profiles/oculus/touch_controller"
bindings = [SubResource("OpenXRIPBinding_s7apu"), SubResource("OpenXRIPBinding_ep310"), SubResource("OpenXRIPBinding_teqpe"), SubResource("OpenXRIPBinding_8mw26"), SubResource("OpenXRIPBinding_xjv8s"), SubResource("OpenXRIPBinding_ihao1")]

[resource]
action_sets = [SubResource("OpenXRActionSet_k6xom")]
interaction_profiles = [SubResource("OpenXRInteractionProfile_au1k2")]
